        ["pg_bullet091", 0, 0, -1, {"pg_bulletID":91}],
        ["pg_bullet092", 0, 0, -1, {"pg_bulletID":92}],
        ["pg_bullet093", 0, 0, -1, {"pg_bulletID":93}],
        ["pg_bullet094", 0, 0, -1, {"pg_bulletID":94}],
        ["pg_bullet095", 0, 0, -1, {"pg_bulletID":95}],
        ["pg_bullet096", 0, 0, -1, {"pg_bulletID":96}],
        ["pg_bullet097", 0, 0, -1, {"pg_bulletID":97}],
        ["pg_bullet098", 0, 0, -1, {"pg_bulletID":98}],
        ["pg_bullet099", 0, 0, -1, {"pg_bulletID":99}],
        ["pg_bullet100", 0, 0, -1, {"pg_bulletID":100}],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":500000,"beamDamp":200},
        // beamDeform FLT_MAX: the mount must NOT bend permanently. Telemetry showed a
        // deformable mount (deform 500000) ending up 2.6m out of position after close
        // blasts, which wrecked aim for the rest of the session (muzzle = bullet spawn).
        {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
        // Internal cage — rectangle + diagonals + gun_node to all 4 corners
        ["pg_ma","pg_mb"],
        ["pg_mb","pg_mc"],
        ["pg_mc","pg_md"],
        ["pg_md","pg_ma"],
        ["pg_ma","pg_mc"],
        ["pg_mb","pg_md"],
        ["pg_gun_node","pg_ma"],
        ["pg_gun_node","pg_mb"],
        ["pg_gun_node","pg_mc"],
        ["pg_gun_node","pg_md"],
        ["pg_cam_up","pg_ma"],
        ["pg_cam_up","pg_mb"],
        ["pg_cam_up","pg_mc"],
        ["pg_cam_up","pg_md"],
        ["pg_cam_up","pg_gun_node"],
        // Roof bar attachment — silently dropped if rfb* nodes don't exist on host vehicle
        ["pg_ma","rfb2l"],
        ["pg_mb","rfb1l"],
        ["pg_mc","rfb1r"],
        ["pg_md","rfb2r"],
        ["pg_ma","rfb1l"],
        ["pg_mb","rfb2l"],
        ["pg_mc","rfb2r"],
        ["pg_md","rfb1r"],
        ["pg_ma","rfb2r"],
        ["pg_md","rfb2l"],
        ["pg_mb","rfb1r"],
        ["pg_mc","rfb1l"],
    ],
    "triangles": [
        ["id1:", "id2:", "id3:"],
        {"dragCoef":2},
        ["pg_ma","pg_mb","pg_mc"],
        ["pg_ma","pg_mc","pg_md"],
    ],
},
}
