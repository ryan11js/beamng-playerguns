// PlayerGuns weapon body for roof mounts (child of playerGuns_roof).
// Uses PROPS (not flexbodies) to display weapons. Flexbodies require every vertex to be
// near a node — at scale=3 the mesh extends 3x beyond the node cluster, causing "VY node
// not found". Props are positioned explicitly via the idRef/idX/idY frame: no vertex search,
// no VY requirement, scale works in extras. Same approach the unicycle uses.

{
"playerGuns_roof_weapon": {
    "information":{
        "authors":"PlayerGuns",
        "name":"Player Guns - Weapon (Roof)",
        "value":0,
    },
    "slotType" : "playerGuns_roof_weapon",
    "controller": [
        ["fileName"],
        ["playerGuns", {}],
    ],
    "playerGuns": {
        "mountContext": "roof",
        "totalBullets": 100,
        "bulletOriginNodeName": "pg_gun_node",
        "gunSoundNodeName": "pg_gun_node",
        "fireParticleNodeInnerName": "pg_gun_node",
        "fireParticleNodeOuterName": "pg_gun_node",
        "hydroAnchorNodeName": "pg_gun_node",
        "bulletSpawnOffset": 1.2,
    },
    // Gun Cam: cycles in with C. Camera node rides the mount frame (slotted-
    // part recipe from the turrets mod: idRef/idBack/idUp orientation plus six
    // anchor beams). Sits behind and above the muzzle, looking forward.
    "camerasInternal": [
        ["type", "x", "y", "z", "fov", "id1:", "id2:", "id3:", "id4:", "id5:", "id6:"],
        {"nodeWeight":0.4},
        {"selfCollision":false},
        {"collision":false},
        {"beamSpring":80000,"beamDamp":50},
        {"idBack:":"pg_ma", "idUp:":"pg_cam_up", "idRef:":"pg_gun_node"},
        {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
        ["gun_cam", 0.0, 0.55, 0.50, 65, "pg_ma", "pg_mb", "pg_mc", "pg_md", "pg_gun_node", "pg_cam_up", {"name":"Gun Cam","beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"}],
        {"selfCollision":false},
        {"collision":false},
    ],
    // Prop frame: idRef=pg_md (left-rear), idX=pg_mc (left-front), idY=pg_ma (right-rear)
    //   e_X (idRef→idY) = vehicle RIGHT  = +X direction
    //   e_Y (idRef→idX) = vehicle FORWARD = -Y direction (covet Y+=rear, so forward=-Y)
    //   e_Z = e_Y × e_X = vehicle UP = +Z
    //
    // baseRotation {x:90,y:90,z:0} orients the gun barrel forward, sights up (verified in-game).
    //
    // POSITION: baseTranslation is rotated by baseRotation, so its axes are PERMUTED relative
    // to vehicle axes (mapped empirically, one axis at a time, in-game):
    //   baseTranslation.x -> vehicle LONGITUDINAL (fwd/back); +x = forward. Slight forward = 0.4.
    //   baseTranslation.y -> vehicle LATERAL (left/right); +y = left. 0.14 = centered.
    //   baseTranslation.z -> vehicle VERTICAL; +z = DOWN (right-handed). LOWER z = higher. 0.0 = roof.
    // Origin-anchored (not idRef). NOTE: the unicycle uses its own prop block in
    // playerGuns_main.jbeam, so this forward offset does NOT affect the walking variant.
    //
    // Visibility: (pg_show_X=0): (0-1)*1*(-1000) = +1000 along e_Z = skyward → hidden
    //             (pg_show_X=1): (1-1)*1*(-1000) = 0 → stays at baseTranslation
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        ["pg_show_pistol",  "unicycle_pistol",  "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
        ["pg_show_uzi",     "unicycle_uzi",     "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
        ["pg_show_tom",     "unicycle_tom",     "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
        ["pg_show_akm",     "unicycle_akm",     "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
        ["pg_show_sniper",  "unicycle_awp",     "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
        ["pg_show_minigun", "unicycle_minigun", "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
        ["pg_show_bazooka", "unicycle_bazooka", "pg_md","pg_mc","pg_ma", {"x":90,"y":90,"z":0}, {"x":0,"y":0,"z":0}, {"x":0,"y":0,"z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":0.4,"y":0.14,"z":0.0}, "scale":{"x":3,"y":3,"z":3}}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        // All nodes collision:false. On a vehicle without rfb* (slot carry-over to van etc.)
        // the rfb beams silently drop and these nodes are unanchored. collision:false
        // prevents them from pushing against the host vehicle's body geometry.
        {"collision":false},
        {"selfCollision":false},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_METAL"},
        {"nodeWeight":1},
        {"group":"pg_roof_mount"},
        // Base rectangle — four corners of the mount pad (z=-0.007 = just below roof bar rail)
        ["pg_ma",  0.1327,  0.23,    -0.0073],
        ["pg_mb",  0.1327, -0.0859,  -0.0073],
        ["pg_mc", -0.1377, -0.0859,  -0.0073],
        ["pg_md", -0.1377,  0.23,    -0.0073],
        // Muzzle/aim node — bullet spawn and fire particles originate here
        {"nodeWeight":0.5},
        ["pg_gun_node",  -0.0002, -0.7804, 0.1033],
        // Orientation reference for the Gun Cam (sits above the mount pad)
        {"nodeWeight":0.25},
        ["pg_cam_up",  0.0, 0.16, 0.45],
        {"group":""},

        // --- Bullet recycling pool (100 nodes, launched/parked by the controller) ---
        // Nodes start at local (0,0,-1) matching UniversalWeapons 50cal's ammo pattern.
        // With roofbars nodeOffset (z+1.415) this maps to world z≈0.415 — just below the
        // vehicle floor/axle level, safely outside body geometry AND above terrain.
        {"collision":true},
        {"selfCollision":false},
        {"nodeWeight":0.01},
        // friction 20 (pw2's value, was 0): parked/stray bullets that touch
        // terrain must STOP, not slide forever around the car.
        {"frictionCoef":20},

        ["pg_bullet001", 0, 0, -1, {"pg_bulletID":1}],
        ["pg_bullet002", 0, 0, -1, {"pg_bulletID":2}],
        ["pg_bullet003", 0, 0, -1, {"pg_bulletID":3}],
        ["pg_bullet004", 0, 0, -1, {"pg_bulletID":4}],
        ["pg_bullet005", 0, 0, -1, {"pg_bulletID":5}],
        ["pg_bullet006", 0, 0, -1, {"pg_bulletID":6}],
        ["pg_bullet007", 0, 0, -1, {"pg_bulletID":7}],
        ["pg_bullet008", 0, 0, -1, {"pg_bulletID":8}],
        ["pg_bullet009", 0, 0, -1, {"pg_bulletID":9}],
        ["pg_bullet010", 0, 0, -1, {"pg_bulletID":10}],
        ["pg_bullet011", 0, 0, -1, {"pg_bulletID":11}],
        ["pg_bullet012", 0, 0, -1, {"pg_bulletID":12}],
        ["pg_bullet013", 0, 0, -1, {"pg_bulletID":13}],
        ["pg_bullet014", 0, 0, -1, {"pg_bulletID":14}],
        ["pg_bullet015", 0, 0, -1, {"pg_bulletID":15}],
        ["pg_bullet016", 0, 0, -1, {"pg_bulletID":16}],
        ["pg_bullet017", 0, 0, -1, {"pg_bulletID":17}],
        ["pg_bullet018", 0, 0, -1, {"pg_bulletID":18}],
        ["pg_bullet019", 0, 0, -1, {"pg_bulletID":19}],
        ["pg_bullet020", 0, 0, -1, {"pg_bulletID":20}],
        ["pg_bullet021", 0, 0, -1, {"pg_bulletID":21}],
        ["pg_bullet022", 0, 0, -1, {"pg_bulletID":22}],
        ["pg_bullet023", 0, 0, -1, {"pg_bulletID":23}],
        ["pg_bullet024", 0, 0, -1, {"pg_bulletID":24}],
        ["pg_bullet025", 0, 0, -1, {"pg_bulletID":25}],
        ["pg_bullet026", 0, 0, -1, {"pg_bulletID":26}],
        ["pg_bullet027", 0, 0, -1, {"pg_bulletID":27}],
        ["pg_bullet028", 0, 0, -1, {"pg_bulletID":28}],
        ["pg_bullet029", 0, 0, -1, {"pg_bulletID":29}],
        ["pg_bullet030", 0, 0, -1, {"pg_bulletID":30}],
        ["pg_bullet031", 0, 0, -1, {"pg_bulletID":31}],
        ["pg_bullet032", 0, 0, -1, {"pg_bulletID":32}],
        ["pg_bullet033", 0, 0, -1, {"pg_bulletID":33}],
        ["pg_bullet034", 0, 0, -1, {"pg_bulletID":34}],
        ["pg_bullet035", 0, 0, -1, {"pg_bulletID":35}],
        ["pg_bullet036", 0, 0, -1, {"pg_bulletID":36}],
        ["pg_bullet037", 0, 0, -1, {"pg_bulletID":37}],
        ["pg_bullet038", 0, 0, -1, {"pg_bulletID":38}],
        ["pg_bullet039", 0, 0, -1, {"pg_bulletID":39}],
        ["pg_bullet040", 0, 0, -1, {"pg_bulletID":40}],
        ["pg_bullet041", 0, 0, -1, {"pg_bulletID":41}],
        ["pg_bullet042", 0, 0, -1, {"pg_bulletID":42}],
        ["pg_bullet043", 0, 0, -1, {"pg_bulletID":43}],
        ["pg_bullet044", 0, 0, -1, {"pg_bulletID":44}],
        ["pg_bullet045", 0, 0, -1, {"pg_bulletID":45}],
        ["pg_bullet046", 0, 0, -1, {"pg_bulletID":46}],
        ["pg_bullet047", 0, 0, -1, {"pg_bulletID":47}],
        ["pg_bullet048", 0, 0, -1, {"pg_bulletID":48}],
        ["pg_bullet049", 0, 0, -1, {"pg_bulletID":49}],
        ["pg_bullet050", 0, 0, -1, {"pg_bulletID":50}],
        ["pg_bullet051", 0, 0, -1, {"pg_bulletID":51}],
        ["pg_bullet052", 0, 0, -1, {"pg_bulletID":52}],
        ["pg_bullet053", 0, 0, -1, {"pg_bulletID":53}],
        ["pg_bullet054", 0, 0, -1, {"pg_bulletID":54}],
        ["pg_bullet055", 0, 0, -1, {"pg_bulletID":55}],
        ["pg_bullet056", 0, 0, -1, {"pg_bulletID":56}],
        ["pg_bullet057", 0, 0, -1, {"pg_bulletID":57}],
        ["pg_bullet058", 0, 0, -1, {"pg_bulletID":58}],
        ["pg_bullet059", 0, 0, -1, {"pg_bulletID":59}],
        ["pg_bullet060", 0, 0, -1, {"pg_bulletID":60}],
        ["pg_bullet061", 0, 0, -1, {"pg_bulletID":61}],
        ["pg_bullet062", 0, 0, -1, {"pg_bulletID":62}],
        ["pg_bullet063", 0, 0, -1, {"pg_bulletID":63}],
        ["pg_bullet064", 0, 0, -1, {"pg_bulletID":64}],
        ["pg_bullet065", 0, 0, -1, {"pg_bulletID":65}],
        ["pg_bullet066", 0, 0, -1, {"pg_bulletID":66}],
        ["pg_bullet067", 0, 0, -1, {"pg_bulletID":67}],
        ["pg_bullet068", 0, 0, -1, {"pg_bulletID":68}],
        ["pg_bullet069", 0, 0, -1, {"pg_bulletID":69}],
        ["pg_bullet070", 0, 0, -1, {"pg_bulletID":70}],
        ["pg_bullet071", 0, 0, -1, {"pg_bulletID":71}],
        ["pg_bullet072", 0, 0, -1, {"pg_bulletID":72}],
        ["pg_bullet073", 0, 0, -1, {"pg_bulletID":73}],
        ["pg_bullet074", 0, 0, -1, {"pg_bulletID":74}],
        ["pg_bullet075", 0, 0, -1, {"pg_bulletID":75}],
        ["pg_bullet076", 0, 0, -1, {"pg_bulletID":76}],
        ["pg_bullet077", 0, 0, -1, {"pg_bulletID":77}],
        ["pg_bullet078", 0, 0, -1, {"pg_bulletID":78}],
        ["pg_bullet079", 0, 0, -1, {"pg_bulletID":79}],
        ["pg_bullet080", 0, 0, -1, {"pg_bulletID":80}],
