// PlayerGuns main weapon mount (walking mode).
// Fills the 'playerGuns_weapon' slot exposed by playerGuns_body.jbeam (which
// in turn fills the stock unicycle_meshes slot). Loads the playerGuns Lua
// controller. The 100 bullet pool nodes live directly in this part — they are
// an internal recycling pool (per-weapon magazine sizes are handled in Lua),
// so they don't need their own slot/part in the vehicle config UI.
// Mirrors player_weapon_2's pw2_guns_v2.jbeam architecture (credit AgentY/AwesomeCarl).
{
"playerGuns_main": {
    "information":{
        "authors":"PlayerGuns (based on AgentY & AwesomeCarl's player_weapon_2)",
        "name":"Player Guns - Weapon System",
        "value":0,
    },
    "slotType" : "playerGuns_weapon",
    "controller": [
        ["fileName"],
        ["playerGuns", {}],
    ],
    "props": [
        ["func", "mesh", "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],
        // All 7 weapons are statically mounted at the same node frame, mirroring
        // pw2's working setup (baseTranslation z=0.12). They stack visually until
        // the controller hides the inactive 6 via GE-side `setMeshAlpha`.
        // Defensive translation hack also runs: pg_show_<weapon> drives Z, so
        // input=0 also pushes inactive meshes 1km below the world (offset=-1,
        // translation.z=-1000 -> value=(0-1)*1=-1 -> finalZ=0.12+(-1)*-1000=1000.12).
        // input=1 (visible): value=(1-1)*1=0 -> finalZ=0.12 (correct).
        ["pg_show_pistol",  "unicycle_pistol",  "r1", "b15", "r2",  {"x":0, "y":0, "z":-90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
        ["pg_show_uzi",     "unicycle_uzi",     "r1", "b15", "r2",  {"x":0, "y":0, "z":-90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
        ["pg_show_tom",     "unicycle_tom",     "r1", "b15", "r2",  {"x":0, "y":0, "z":-90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
        ["pg_show_akm",     "unicycle_akm",     "r1", "b15", "r2",  {"x":0, "y":0, "z":-90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
        ["pg_show_sniper",  "unicycle_awp",     "r1", "b15", "r2",  {"x":0, "y":0, "z":-90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
        ["pg_show_minigun", "unicycle_minigun", "r1", "b15", "r2",  {"x":0, "y":0, "z":90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
        ["pg_show_bazooka", "unicycle_bazooka", "r1", "b15", "r2",  {"x":0, "y":0, "z":-90}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":-1000}, 0, 1, -1, 1, {"baseTranslation":{"x":-0.38,"y":0.47,"z":0.12}, "scale":{"x":2,"y":2,"z":2}}],
    ],
